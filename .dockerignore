# Что не попадает в сборку образа (Dockerfile).
# Это не только размер: локальные данные на сервере опасны — тестовая база из этой папки
# затерла бы настоящую, а чужой .env подменил бы настройки сервера.

# --- Данные: ничего из локальных данных в образ не попадает ---
# База разработчика и ее файлы WAL. На сервере база лежит в подключенной папке /data.
server/data/
*.db
*.db-wal
*.db-shm
# Резервные копии базы и загруженные фото работ.
server/backups/
server/uploads/

# --- Настройки: на сервере свои ---
# .env содержит пароли почты и тестовых учетных записей; настройки задаются при запуске контейнера.
.env
.env.*
server/.env
server/.env.*

# --- Установленные зависимости: ставятся внутри образа командой npm ci ---
node_modules/
**/node_modules/
npm-debug.log*

# --- История изменений и служебное ---
.git/
.gitignore
.gitattributes
.github/
.claude/

# --- Собранное локально: образ собирает сам ---
server/dist/
web-draft/dist/

# --- Не нужно серверу ---
# Тесты и тестовые данные: в образ идет только собранный dist/ (tsconfig.build.json их и так не берет).
server/test/
# Прототип, черновой интерфейс для проверки API и документация — к работе сервиса отношения не имеют.
Prototype/
web-draft/
docs/
*.md
*.jpg
tools/
