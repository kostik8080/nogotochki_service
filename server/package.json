{
  "name": "nogotochki-server",
  "version": "0.1.0",
  "private": true,
  "description": "Серверная часть «Ноготочки. Онлайн-запись»",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "db:migrate": "tsx --import ./scripts/node-version.mjs scripts/db-migrate.ts",
    "db:seed": "tsx --import ./scripts/node-version.mjs scripts/db-seed.ts",
    "db:reset": "tsx --import ./scripts/node-version.mjs scripts/db-reset.ts",
    "db:backup": "tsx --import ./scripts/node-version.mjs scripts/db-backup.ts",
    "db:check-schema": "tsx --import ./scripts/node-version.mjs scripts/db-check-schema.ts",
    "admin:create": "tsx --import ./scripts/node-version.mjs scripts/admin-create.ts",
    "build": "node --import ./scripts/node-version.mjs scripts/build.mjs",
    "prod:migrate": "node --import ./scripts/node-version.mjs dist/scripts/db-migrate.js",
    "prod:backup": "node --import ./scripts/node-version.mjs dist/scripts/db-backup.js",
    "prod:admin:create": "node --import ./scripts/node-version.mjs dist/scripts/admin-create.js",
    "test": "tsx --import ./scripts/node-version.mjs --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
