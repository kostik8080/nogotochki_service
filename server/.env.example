# Переменные окружения сервера «Ноготочки».
# Скопируйте файл в .env (он не попадает в git) и заполните значения.
# Пустое значение означает «взять значение по умолчанию», оно указано в комментарии.

# ---- Используются сейчас ----

# Режим работы: development | test | production. По умолчанию development.
# В production команды db:seed и db:reset отказываются работать.
NODE_ENV=

# Путь к файлу базы SQLite. При разработке — относительно папки server/, по умолчанию data/nogotochki.db.
# В production обязателен, абсолютный и вне папки с кодом, например /var/lib/nogotochki/nogotochki.db:
# папку с кодом заменяют при обновлении, и база внутри нее пропала бы.
DATABASE_PATH=

# Папка резервных копий базы (npm run db:backup). При разработке — относительно server/, по умолчанию backups.
# В production обязательна, абсолютная, вне папки с кодом и не та же, что у базы,
# например /var/backups/nogotochki.
BACKUP_DIR=

# Сколько последних копий хранить, более старые удаляются. По умолчанию 14 (две недели при ежедневной копии).
BACKUP_KEEP=

# Пароли тестовых учетных записей для npm run db:seed (не короче 8 символов). В production не задаются.
# Логины заданы в тестовых данных: администратор admin@example.com, мастер anna@example.com,
# клиентка maria@example.com. Пароль меняется только у нового пользователя: у существующего
# повторный запуск db:seed его не трогает, для смены — npm run db:reset.
SEED_ADMIN_PASSWORD=
SEED_MASTER_PASSWORD=
SEED_CLIENT_PASSWORD=

# Порт HTTP-сервера API (npm start). По умолчанию 3000.
PORT=

# 1 — сервер стоит за прокси (nginx, панель хостинга) и IP клиента берется из заголовка X-Forwarded-For.
# Нужен для ограничения частоты запросов. Без прокси оставьте 0: иначе клиент подделает свой IP. По умолчанию 0.
TRUST_PROXY=

# Редакция политики обработки персональных данных, на которую соглашается клиент при регистрации
# (сохраняется в users.pd_consent_version). По умолчанию 2026-09-01.
PD_POLICY_VERSION=

# ---- Понадобятся на следующих этапах (письма, фото) ----

# Публичный адрес сервиса: из него строятся ссылки в письмах (сброс пароля, подтверждение e-mail).
APP_URL=

# Папка для фото работ относительно server/. По умолчанию uploads. В базе хранится только путь к файлу.
UPLOADS_DIR=

# Почтовый сервис: одноразовые коды и ссылки для сброса пароля.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS-шлюз: коды подтверждения телефона. Пока шлюз не подключен, оставьте пустым.
SMS_API_URL=
SMS_API_KEY=
